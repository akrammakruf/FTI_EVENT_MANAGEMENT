<%- include('../partials/header') %><div class="card"><div class="flex justify-between items-center mb-5"><h2 class="text-xl font-bold">Sertifikat Event</h2><form action="/sertifikat/generate" method="POST"><button class="btn-primary">Generate Sertifikat Peserta Hadir</button></form></div><table class="table"><thead><tr><th>Peserta</th><th>Event</th><th>Hadir</th><th>No Sertifikat</th><th>Aksi</th></tr></thead><tbody><% data.forEach(item=>{ %><tr><td><%= item.nama %></td><td><%= item.nama_event %></td><td><%= item.hadir ? 'Ya' : 'Belum' %></td><td><%= item.nomor_sertifikat || '-' %></td><td><% if(item.sertifikat_id){ %><a class="link" href="/sertifikat/<%= item.sertifikat_id %>">Lihat</a><% } else { %>Belum tersedia<% } %></td></tr><% }) %></tbody></table></div><%- include('../partials/footer') %>
