<%- include('../partials/header') %><div class="card"><div class="flex justify-between items-center mb-5"><h2 class="text-xl font-bold">Daftar Peserta</h2><a href="/peserta/add" class="btn-primary">Tambah Peserta</a></div><table class="table"><thead><tr><th>ID</th><th>Nama</th><th>Email</th><th>Event</th><th>Tiket</th><th>Hadir</th><th>Aksi</th></tr></thead><tbody><% peserta.forEach(p=>{ %><tr><td><%= p.id %></td><td><%= p.nama %></td><td><%= p.email %></td><td><%= p.nama_event %></td><td><%= p.status_tiket %></td><td><%= p.hadir ? 'Ya' : 'Belum' %></td><td><a class="link" href="/peserta/<%= p.id %>">Detail</a></td></tr><% }) %></tbody></table></div><%- include('../partials/footer') %>
