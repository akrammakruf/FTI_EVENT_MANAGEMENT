<%- include('../partials/header') %><div class="card max-w-xl mx-auto"><h2 class="text-xl font-bold mb-4">Tambah Peserta</h2><form action="/peserta" method="POST" class="space-y-4"><input class="input" name="nama" placeholder="Nama peserta" required><input class="input" name="email" type="email" placeholder="Email" required><input class="input" name="no_hp" placeholder="Nomor HP"><select class="input" name="event_id" required><option value="">Pilih Event</option><% events.forEach(e=>{ %><option value="<%= e.id %>"><%= e.nama_event %></option><% }) %></select><button class="btn-primary w-full">Simpan Peserta</button></form></div><%- include('../partials/footer') %>
