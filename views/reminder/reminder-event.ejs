<%- include('../partials/header') %><div class="card max-w-xl mx-auto"><h2 class="text-xl font-bold mb-4">Kirim Reminder Event</h2><% if(message){ %><div class="alert-success"><%= message %></div><% } %><form action="/reminder/send" method="POST" class="space-y-4"><select class="input" name="event_id" required><option value="">Pilih Event</option><% events.forEach(e=>{ %><option value="<%= e.id %>"><%= e.nama_event %></option><% }) %></select><textarea class="input" name="pesan" required>Jangan lupa hadir pada event yang telah Anda daftarkan.</textarea><button class="btn-primary w-full">Kirim Reminder</button></form></div><%- include('../partials/footer') %>
